# ============================================================================
# Medvox — Docker Compose environment
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ============================================================================

# --- PostgreSQL ---
POSTGRES_DB=medvox
POSTGRES_USER=medvox
POSTGRES_PASSWORD=test123

# --- Application ---
APP_ENV=production
APP_DEBUG=false

# --- JWT (must be at least 32 bytes; generate with: openssl rand -hex 32) ---
JWT_SECRET=5efc0661f7db103b8e307f2d87c3bcaffd1ec78482d3de2955df71699d28658b
JWT_ISSUER=medvox
JWT_TTL=3600

# --- Rate limiting (login) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
