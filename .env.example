# ============================================================================
# Medvox — Docker Compose environment
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ============================================================================

# --- PostgreSQL ---
POSTGRES_DB=medvox
POSTGRES_USER=medvox
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --- Application ---
APP_ENV=production
APP_DEBUG=false

# --- JWT (must be at least 32 bytes; generate with: openssl rand -hex 32) ---
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_bytes
JWT_ISSUER=medvox
JWT_TTL=3600

# --- Rate limiting (login) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
