# ============================================================================
# Medvox backend — environment variables (example)
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ============================================================================

# --- Application ---
APP_ENV=production
APP_DEBUG=false

# --- Database (PostgreSQL 18) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=medvox
DB_USER=postgres
DB_PASSWORD=change_me
DB_CHARSET=utf8

# --- JWT ---
# Must be at least 32 bytes long. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_bytes
JWT_ISSUER=medvox
JWT_TTL=3600

# --- Rate limiting (login endpoints) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
# RATE_LIMIT_STORAGE=/absolute/path/to/storage/rate_limit
